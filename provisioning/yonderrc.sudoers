# YonderRC — passwordless sudo for the vehicle service's privileged helpers.
# ---------------------------------------------------------------------------
# WHEN YOU NEED THIS
#   Only if you run the yonderrc-vehicle service as a NON-ROOT user.
#   The shipped systemd unit runs as `User=root` (pigpio needs root for PWM),
#   and then this file is NOT needed — root already has these rights.
#
# WHAT IT ALLOWS (and why)
#   mmcli        — unlock a PIN-locked SIM               (Vehicle setup › Network › LTE)
#   wg, wg-quick — bring the WireGuard tunnel up/down, and look a DynDNS endpoint up
#                  again when the handshake goes stale  (Vehicle setup › Remote access)
#   install      — place the uploaded WireGuard .conf into /etc/wireguard, and the
#                  OpenVPN profile + credentials into /etc/openvpn/client
#   systemctl … openvpn-client@yonderrc — start/stop the OpenVPN tunnel, and make it
#                  reconnect at once after the vehicle changed networks
#                  (experimental; exactly the four commands RealSystem runs)
#   zerotier-cli — join/leave a ZeroTier network         (Vehicle setup › Remote access)
#   reboot       — the "Reboot vehicle" button           (Vehicle setup › Overview)
#   rfkill       — unblock the WiFi radio                (Vehicle setup › Network › WiFi)
#   raspi-config — set the WiFi country, which is what unblocks it in the first
#                  place on Raspberry Pi OS; switch VNC on/off and read its state
#                  (Vehicle setup › Network › WiFi, › Device access)
#   systemctl    — "Restart service now" after installing a native driver
#                  module (Vehicle setup › Core setup). The npm install
#                  itself is NOT sudo: the service user must own /opt/yonderrc.
#   systemctl enable --now ssh — switch SSH on            (Vehicle setup › Device access)
#   apt-get      — install Raspberry Pi Connect, exactly those packages
#                  (Vehicle setup › Core setup › Add-ons)
#   loginctl enable-linger — let the login user's Raspberry Pi Connect service run
#                  without a login. The Connect CLI itself runs as THAT user: with a
#                  non-root service this works only when the service user IS the
#                  login user (runuser is root-only).
#   (NetworkManager/`nmcli` is NOT listed — grant it to the user via polkit or
#    the `netdev` group instead of sudo. It is what Vehicle setup › Network uses to
#    scan, join a network and (re)start the onboarding hotspot, and what LTE dials with.)
#
# INSTALL (replace "yonderrc" with your actual service user)
#   sudo cp provisioning/yonderrc.sudoers /etc/sudoers.d/yonderrc
#   sudo sed -i 's/^yonderrc /YOURUSER /' /etc/sudoers.d/yonderrc   # if not "yonderrc"
#   sudo chmod 0440 /etc/sudoers.d/yonderrc
#   sudo visudo -cf /etc/sudoers.d/yonderrc      # must print ": parsed OK"
#
# SECURITY NOTE
#   Granting `install` effectively allows writing files as root (it is what
#   places the WireGuard conf). If you want stricter isolation, drop `install`
#   here and instead install a tiny fixed wrapper script that copies the conf to
#   the one allowed path, and grant sudo only to that wrapper.
# ---------------------------------------------------------------------------

Cmnd_Alias YONDERRC = \
    /usr/bin/mmcli, \
    /usr/bin/wg, \
    /usr/bin/wg-quick, \
    /usr/bin/install, \
    /usr/sbin/zerotier-cli, /usr/bin/zerotier-cli, \
    /usr/sbin/reboot, /sbin/reboot, \
    /usr/sbin/rfkill, /usr/bin/rfkill, \
    /usr/bin/raspi-config, \
    /usr/bin/systemctl restart yonderrc-vehicle.service, \
    /usr/bin/systemctl enable openvpn-client@yonderrc, \
    /usr/bin/systemctl restart --no-block openvpn-client@yonderrc, \
    /usr/bin/systemctl disable --now openvpn-client@yonderrc, \
    /usr/bin/systemctl kill -s SIGUSR1 openvpn-client@yonderrc, \
    /usr/bin/systemctl enable --now ssh, \
    /usr/bin/apt-get update, \
    /usr/bin/apt-get install -y rpi-connect-lite, \
    /usr/bin/apt-get install -y rpi-connect, \
    /usr/bin/loginctl enable-linger *

yonderrc ALL=(root) NOPASSWD: YONDERRC
