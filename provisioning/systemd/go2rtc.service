[Unit]
Description=go2rtc (YonderRC video)
After=network.target

[Service]
Type=simple
# The config is GENERATED by the vehicle service from the camera settings, so it
# lives in /var/lib — not in the git checkout, which it would dirty on every start
# and thereby block every `git pull --ff-only`. Keep this path identical to
# YRC_GO2RTC_CONFIG in yonderrc-vehicle.service.
ExecStart=/usr/local/bin/go2rtc -config /var/lib/yonderrc/go2rtc.yaml
Restart=always
RestartSec=2
User=root

[Install]
WantedBy=multi-user.target
