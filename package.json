{
  "name": "yonderrc",
  "version": "1.52.0",
  "private": true,
  "type": "module",
  "description": "YonderRC \u2014 beyond-line-of-sight RC control over IP. One app for video, control and configuration.",
  "workspaces": [
    "packages/protocol",
    "packages/vehicle",
    "packages/ground",
    "packages/desktop"
  ],
  "scripts": {
    "dev": "concurrently -n vehicle,ground -c cyan,magenta \"npm run dev -w @yonderrc/vehicle\" \"npm run dev -w @yonderrc/ground\"",
    "dev:vehicle": "npm run dev -w @yonderrc/vehicle",
    "dev:ground": "npm run dev -w @yonderrc/ground",
    "dev:desktop": "npm run dev -w @yonderrc/desktop",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build -w @yonderrc/ground",
    "build:desktop": "npm run build -w @yonderrc/desktop",
    "dev:video": "bash scripts/dev-video.sh",
    "test": "tsx test/suite.mts"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "Philipp Weber"
}
